# ─── Storage ──────────────────────────────────────────────────────────────
INBOX_DIR=/data/inbox
PROCESSING_DIR=/data/processing
DONE_DIR=/data/done
FAILED_DIR=/data/failed
DUPLICATES_DIR=/data/duplicates
UNSUPPORTED_DIR=/data/unsupported
DB_PATH=/db/ingestor.db

# ─── Qdrant (rag-internal network) ────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=open-webui_knowledge
QDRANT_KNOWLEDGE_BASE_ID=
EMBEDDING_DIMENSIONS=768

# ─── Ollama (host) ────────────────────────────────────────────────────────
OLLAMA_HOST=http://host.docker.internal:11434
EMBEDDING_MODEL=bge-m3:latest

# ─── Pipeline tuning ──────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50
WORKER_CONCURRENCY=4

# ─── OpenWebUI integration ────────────────────────────────────────────────
OPENWEBUI_USER_ID=<USER-ID>

# ─── Auth ─────────────────────────────────────────────────────────────────
# PIN required to access the dashboard. Default: 1234. Change for production.
ADMIN_PIN=1234
