# ─── Storage ──────────────────────────────────────────────────────────────────
# All subdirectories (inbox, done, failed, duplicates, unsupported, processing)
# are created automatically inside DATA_DIR on first start.
DATA_DIR=/data
DB_PATH=/db/ingestor.db

# ─── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=open-webui_knowledge
QDRANT_KNOWLEDGE_BASE_ID=
EMBEDDING_DIMENSIONS=1024

# ─── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://host.docker.internal:11434
EMBEDDING_MODEL=bge-m3:latest

# ─── Pipeline tuning ──────────────────────────────────────────────────────────
CHUNK_SIZE=1024
CHUNK_OVERLAP=100
WORKER_CONCURRENCY=64        # parallel files being processed simultaneously
EMBEDDING_BATCH_SIZE=128     # chunks per Ollama embed call
EMBED_CONCURRENCY=16         # GLOBAL cap on concurrent embed batches
UPSERT_CONCURRENCY=8         # GLOBAL cap on concurrent Qdrant upserts
STABILITY_WAIT_S=0           # 0 disables; raise only for non-atomic uploads

# ─── OpenWebUI ────────────────────────────────────────────────────────────────
OPENWEBUI_USER_ID=<USER-ID>

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Dashboard password — any characters allowed, min 8 recommended.
# No default: the app refuses to start if this is not set.
ADMIN_PASSWORD=

# Audit log retention (days) and warning threshold for total log dir size.
AUTH_LOG_RETENTION_DAYS=30
AUTH_LOG_MAX_TOTAL_MB=100
