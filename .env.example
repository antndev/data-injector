DATA_DIR=/data
DB_PATH=/db/ingestor.db
DELETE_AFTER_INGEST=true

OPENWEBUI_URL=http://openwebui:8080
OPENWEBUI_API_KEY=
OPENWEBUI_KNOWLEDGE_ID=
OPENWEBUI_BATCH_SIZE=15
OPENWEBUI_BATCH_SECONDS=5.0
STABILITY_WAIT_S=0

OLLAMA_HOST=http://host.docker.internal:11434
VISION_ENABLED=true
VISION_MODEL=glm-ocr
ASR_ENABLED=true
ASR_LANGUAGE=de
WORKER_CONCURRENCY=4
MEDIA_CONCURRENCY=8

UPLOAD_CHUNK_BYTES=8388608
UPLOAD_TTL_HOURS=48
UPLOAD_MAX_BYTES=0

ADMIN_PASSWORD=
AUTH_LOG_RETENTION_DAYS=30
AUTH_LOG_MAX_TOTAL_MB=100
