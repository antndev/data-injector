# ─── Storage ──────────────────────────────────────────────────────────────────
# All subdirectories (inbox, processing, done, failed, duplicates, unsupported,
# _uploads) are created automatically inside DATA_DIR on first start.
DATA_DIR=/data
DB_PATH=/db/ingestor.db

# When true (default), a file is deleted from disk as soon as its vectors are in
# Qdrant — so customer content lives only in the vector DB. false keeps finished
# files in DATA_DIR/done.
DELETE_AFTER_INGEST=true

# ─── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=open-webui_knowledge
QDRANT_KNOWLEDGE_BASE_ID=
EMBEDDING_DIMENSIONS=1024

# ─── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://host.docker.internal:11434
EMBEDDING_MODEL=bge-m3:latest

# ─── Pipeline tuning ──────────────────────────────────────────────────────────
CHUNK_SIZE=1024
CHUNK_OVERLAP=100
WORKER_CONCURRENCY=64        # parallel files being processed simultaneously
EMBEDDING_BATCH_SIZE=128     # chunks per Ollama embed call
EMBED_CONCURRENCY=16         # GLOBAL cap on concurrent embed batches
UPSERT_CONCURRENCY=8         # GLOBAL cap on concurrent Qdrant upserts
STABILITY_WAIT_S=0           # 0 disables; raise only for non-atomic uploads

# ─── Resumable upload ─────────────────────────────────────────────────────────
UPLOAD_CHUNK_BYTES=8388608   # 8 MiB chunks the dashboard uploads with
UPLOAD_TTL_HOURS=48          # reap abandoned upload partials after N idle hours
UPLOAD_MAX_BYTES=0           # 0 = unlimited; else reject larger uploads

# ─── OpenWebUI ────────────────────────────────────────────────────────────────
OPENWEBUI_USER_ID=<USER-ID>
# Path to OpenWebUI's shared sqlite DB inside this container (must match the
# volume mount in compose.yaml). The app fails loud at startup if it's wrong.
OPENWEBUI_DB_PATH=/openwebui-data/webui.db

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Dashboard password — any characters allowed, min 8 recommended.
# No default: the app refuses to start if this is not set.
ADMIN_PASSWORD=

# Audit log retention (days) and warning threshold for total log dir size.
AUTH_LOG_RETENTION_DAYS=30
AUTH_LOG_MAX_TOTAL_MB=100
