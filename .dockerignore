# Keep the build context small. Without this, Docker uploads .venv, .git and the
# whole data/ + db/ tree on every build, which is slow and pointlessly leaks
# local runtime state into the daemon.
.git
.github
.venv
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Local runtime state — never belongs in an image build.
data/
db/
.env
*.db

docs/
deploy/
*.md
!README.md
LICENSE
*.iml
.DS_Store
